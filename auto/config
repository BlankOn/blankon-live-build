#!/bin/sh
set -e

. config/includes.chroot/etc/blankon/archive.conf

VARIANT=$(cat variant)
case "$VARIANT" in
  ''|*[!a-z0-9-]*)
    printf 'Error: invalid variant: %s\n' "$VARIANT" >&2
    exit 1
    ;;
esac

lb config noauto \
  --architectures amd64 \
  --distribution "$ARCHIVE_SUITE" \
  --parent-distribution "$ARCHIVE_SUITE" \
  --archive-areas "main extras restricted restricted-firmware" \
  --parent-archive-areas "main restricted extras restricted-firmware" \
  --mirror-bootstrap "$ARCHIVE_URI" \
  --parent-mirror-bootstrap "$ARCHIVE_URI" \
  --mirror-chroot "$ARCHIVE_URI" \
  --parent-mirror-chroot "$ARCHIVE_URI" \
  --mirror-chroot-security "$ARCHIVE_URI" \
  --parent-mirror-chroot-security "$ARCHIVE_URI" \
  --mirror-binary "$ARCHIVE_URI" \
  --parent-mirror-binary "$ARCHIVE_URI" \
  --mirror-binary-security "$ARCHIVE_URI" \
  --parent-mirror-binary-security "$ARCHIVE_URI" \
  --mirror-debian-installer "$ARCHIVE_URI" \
  --parent-mirror-debian-installer "$ARCHIVE_URI" \
  --apt-indices false \
  --apt-recommends false \
  --apt-secure true \
  --cache true \
  --cache-indices false \
  --cache-packages true \
  --cache-stages bootstrap \
  --debootstrap-options "--keyring=/usr/share/keyrings/blankon-archive-keyring.gpg --variant=minbase" \
  --debootstrap-script sid \
  --mode blankon \
  --system live \
  --initsystem systemd \
  --image-name "blankon-live-image-$VARIANT" \
  --binary-image iso-hybrid \
  --binary-filesystem fat32 \
  --bootappend-live "boot=live components username=blankon hostname=blankon console=tty0 console=ttyS0,115200n8 blankon.ci=1" \
  --bootloaders "syslinux grub-efi" \
  --checksums sha256 \
  --compression gzip \
  --debian-installer none \
  --firmware-binary false \
  --firmware-chroot false \
  --iso-application "BlankOn Live CI" \
  --iso-publisher "BlankOn Revival Project; https://blankonlinux.id" \
  --iso-volume "BlankOn ${ARCHIVE_SUITE} CI" \
  --keyring-packages blankon-keyring \
  --linux-flavours amd64 \
  --linux-packages linux-image \
  --memtest none \
  --security false \
  --updates false \
  --backports false \
  --source false \
  --uefi-secure-boot disable \
  --win32-loader false \
  "$@"

#!/bin/sh

WALLPAPER="/usr/share/backgrounds/xfce/xfce-blue.jpg"
CHANNEL="xfce4-desktop"

[ -f "$WALLPAPER" ] || exit 0

# Wait until XFCE desktop is running.
for i in $(seq 1 30); do
    pgrep -x xfdesktop >/dev/null && break
    sleep 1
done

pgrep -x xfdesktop >/dev/null || exit 0

# Allow XFCE configuration service to initialize.
sleep 2

# Detect connected monitors using Xrandr.
MONITORS=$(
    xrandr --query |
    awk '$2 == "connected" { print $1 }'
)

# Fallback for systems where monitor detection fails.
[ -n "$MONITORS" ] || MONITORS="Virtual-1"

for MONITOR in $MONITORS; do
    BASE="/backdrop/screen0/monitor${MONITOR}/workspace0"

    xfconf-query -c "$CHANNEL" \
        -p "$BASE/last-image" --create \
        -t string -s "$WALLPAPER"
done

xfdesktop --reload

exit 0

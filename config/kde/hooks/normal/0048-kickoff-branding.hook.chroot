#!/bin/sh
set -e

# Fallback for older Plasma versions that ship Kickoff main.xml
KICKOFF_XML="/usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml"
if [ -f "$KICKOFF_XML" ]; then
    sed -i -E 's/<default>start-here-[a-zA-Z0-9-]+<\/default>/<default>start-here-blankon-symbolic<\/default>/' "$KICKOFF_XML"
fi

# Refresh icon caches so Plasma picks up the BlankOn start-here icons
for theme in breeze breeze-dark hicolor; do
    if [ -f "/usr/share/icons/${theme}/index.theme" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "/usr/share/icons/${theme}" || true
    fi
done

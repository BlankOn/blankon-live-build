#!/bin/sh

set -e

# Create the "blankon" live user during build so it exists in the squashfs
# image. This ensures GDM sees a real user at startup.
# live-config will still configure password, groups, sudo, etc. at boot.
if ! id blankon >/dev/null 2>&1; then
	useradd -m -s /bin/bash blankon
	echo "blankon:live" | chpasswd
fi

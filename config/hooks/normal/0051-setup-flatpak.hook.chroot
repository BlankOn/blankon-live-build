#!/bin/sh

set -e

# Add Flathub remote at build time so it is baked into the squashfs
# and available immediately after installation (no network required at first boot)
flatpak remote-add --if-not-exists --system flathub https://flathub.org/repo/flathub.flatpakrepo || true

# Also enable the service as a fallback in case the build-time step failed
systemctl enable flatpak-add-flathub.service

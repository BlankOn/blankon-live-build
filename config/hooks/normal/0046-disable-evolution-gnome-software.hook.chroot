#!/bin/sh

set -e

# Disable Evolution services (systemd user units)
mkdir -p /etc/systemd/user
ln -sf /dev/null /etc/systemd/user/evolution-alarm-notify.service
ln -sf /dev/null /etc/systemd/user/evolution-source-registry.service
ln -sf /dev/null /etc/systemd/user/evolution-addressbook-factory.service
ln -sf /dev/null /etc/systemd/user/evolution-calendar-factory.service

# Disable GNOME Software autostart
if [ -f /etc/xdg/autostart/gnome-software-service.desktop ]; then
	echo "Hidden=true" >> /etc/xdg/autostart/gnome-software-service.desktop
fi

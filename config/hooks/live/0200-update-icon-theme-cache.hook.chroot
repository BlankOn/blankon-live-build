#!/bin/bash
set -Eeuo pipefail

ICON_DIR="/usr/share/icons"
LOG="/var/log/blankon-icon-cache.log"

exec > >(tee -a "$LOG") 2>&1

echo "========================================"
echo "[BlankOn XFCE] Automatic Icon Cache"
echo "Date: $(date)"
echo "========================================"

command -v gtk-update-icon-cache >/dev/null 2>&1 || {
    echo "[ERROR] gtk-update-icon-cache not found"
    exit 1
}

SUCCESS=0
SKIPPED=0
FAILED=0

for theme_dir in "$ICON_DIR"/*; do
    [ -d "$theme_dir" ] || continue
    [ -f "$theme_dir/index.theme" ] || continue

    theme="${theme_dir##*/}"

    # Baca daftar direktori ikon dari index.theme
    directories=$(sed -n '/^\[Icon Theme\]/,/^\[/p' \
        "$theme_dir/index.theme" |
        sed -n 's/^Directories=//p' |
        head -n 1)

    # Lewati theme deprecated/alias tanpa direktori ikon
    if [ -z "$directories" ]; then
        echo "[SKIP] $theme (no icon directories)"
        SKIPPED=$((SKIPPED + 1))
        continue
    fi

    echo "[CACHE] $theme"

    if gtk-update-icon-cache --force --quiet "$theme_dir" &&
       [ -s "$theme_dir/icon-theme.cache" ]; then
        echo "[OK] $theme"
        SUCCESS=$((SUCCESS + 1))
    else
        echo "[FAILED] $theme"
        FAILED=$((FAILED + 1))
    fi
done

echo "========================================"
echo "Successful: $SUCCESS"
echo "Skipped:    $SKIPPED"
echo "Failed:     $FAILED"
echo "========================================"

if [ "$FAILED" -gt 0 ]; then
    exit 1
fi

echo "[SUCCESS] Icon cache generation completed."

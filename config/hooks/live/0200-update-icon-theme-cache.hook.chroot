#!/bin/bash
set -Eeuo pipefail

ICON_DIR="/usr/share/icons"
LOG="/var/log/blankon-icon-cache.log"

exec > >(tee -a "$LOG") 2>&1

echo "========================================"
echo "[BlankOn XFCE] Automatic Icon Cache"
echo "Date: $(date)"
echo "========================================"

if ! command -v gtk-update-icon-cache >/dev/null 2>&1; then
    echo "[ERROR] gtk-update-icon-cache not found."
    exit 1
fi

SUCCESS=0
FAILED=0
SKIPPED=0

for theme_dir in "$ICON_DIR"/*; do
    [ -d "$theme_dir" ] || continue

    theme="${theme_dir##*/}"

    if [ ! -f "$theme_dir/index.theme" ]; then
        echo "[SKIP] $theme (index.theme missing)"
        SKIPPED=$((SKIPPED + 1))
        continue
    fi

    echo "[CACHE] $theme"

    if gtk-update-icon-cache --force --quiet --include-image-data "$theme_dir"; then
        if [ -s "$theme_dir/icon-theme.cache" ]; then
            echo "[OK] $theme"
            SUCCESS=$((SUCCESS + 1))
        else
            echo "[FAILED] $theme (cache not generated)"
            FAILED=$((FAILED + 1))
        fi
    else
        echo "[FAILED] $theme (generator error)"
        FAILED=$((FAILED + 1))
    fi
done

echo "========================================"
echo "Successful: $SUCCESS"
echo "Failed:     $FAILED"
echo "Skipped:    $SKIPPED"
echo "========================================"

if [ "$FAILED" -gt 0 ]; then
    echo "[ERROR] Some icon caches failed."
    exit 1
fi

echo "[SUCCESS] All icon caches generated."
